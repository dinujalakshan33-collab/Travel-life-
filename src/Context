// src/context/AuthContext.tsx
import React, { createContext, useContext, useState, useEffect } from "react";
import { supabase, isSupabaseConfigured } from "../lib/supabase";
import type { User as SupabaseUser } from "@supabase/supabase-js";

export interface UserProfile {
  id: string;
  name: string;
  email: string;
  avatarUrl?: string;
  emailVerified: boolean;
  savedDestinationIds: string[];
  createdAt: string;
}

export interface AdminSession {
  isAdmin: boolean;
  username: string;
  token?: string;
}

interface AuthContextType {
  user: UserProfile | null;
  admin: AdminSession | null;
  isLoading: boolean;
  isSupabaseLive: boolean;
  // User Actions
  signUpUser: (name: string, email: string, pass: string) => Promise<{ success: boolean; message?: string }>;
  loginUser: (email: string, pass: string) => Promise<{ success: boolean; message?: string }>;
  loginWithOAuth: (provider: "google" | "facebook") => Promise<void>;
  logoutUser: () => Promise<void>;
  sendPasswordReset: (email: string) => Promise<{ success: boolean; message?: string }>;
  toggleSaveDestination: (destId: string) => void;
  isSaved: (destId: string) => boolean;
  // Existing Admin Preservation Actions
  loginAdmin: (token: string, username: string) => void;
  logoutAdmin: () => void;
}

const AuthContext = createContext<AuthContextType | undefined>(undefined);

export const AuthProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [user, setUser] = useState<UserProfile | null>(null);
  const [admin, setAdmin] = useState<AdminSession | null>(null);
  const [isLoading, setIsLoading] = useState(true);

  // Synchronize User and Admin on mount
  useEffect(() => {
    // 1. Restore Admin Session (Preserved from existing setup)
    const storedAdminToken = localStorage.getItem("travellife_admin_token");
    const storedAdminUser = localStorage.getItem("travellife_admin_user");
    if (storedAdminToken) {
      setAdmin({
        isAdmin: true,
        username: storedAdminUser || "Admin",
        token: storedAdminToken,
      });
    }

    // 2. Restore User Session
    if (isSupabaseConfigured && supabase) {
      supabase.auth.getSession().then(({ data: { session } }) => {
        if (session?.user) {
          syncSupabaseUser(session.user);
        }
        setIsLoading(false);
      });

      const { data: authListener } = supabase.auth.onAuthStateChange((_event, session) => {
        if (session?.user) {
          syncSupabaseUser(session.user);
        } else {
          setUser(null);
        }
        setIsLoading(false);
      });

      return () => {
        authListener.subscription.unsubscribe();
      };
    } else {
      // Local persistent fallback for testing before Supabase keys are added
      const localUser = localStorage.getItem("travellife_local_user");
      if (localUser) {
        try {
          setUser(JSON.parse(localUser));
        } catch {
          localStorage.removeItem("travellife_local_user");
        }
      }
      setIsLoading(false);
    }
  }, []);

  const syncSupabaseUser = (sbUser: SupabaseUser) => {
    const existingWishlist = JSON.parse(
      localStorage.getItem(`wishlist_${sbUser.id}`) || "[\"sigiriya\", \"ella\"]"
    );

    setUser({
      id: sbUser.id,
      name: sbUser.user_metadata?.full_name || sbUser.email?.split("@")[0] || "Explorer",
      email: sbUser.email || "",
      avatarUrl: sbUser.user_metadata?.avatar_url,
      emailVerified: Boolean(sbUser.email_confirmed_at),
      savedDestinationIds: existingWishlist,
      createdAt: sbUser.created_at,
    });
  };

  // User Sign Up
  const signUpUser = async (name: string, email: string, pass: string) => {
    setIsLoading(true);
    if (isSupabaseConfigured && supabase) {
      const { data, error } = await supabase.auth.signUp({
        email,
        password: pass,
        options: {
          data: { full_name: name },
        },
      });

      setIsLoading(false);
      if (error) return { success: false, message: error.message };

      if (data.user && !data.session) {
        return {
          success: true,
          message: "Registration successful! Please check your email to verify your account.",
        };
      }
      return { success: true };
    } else {
      // Standalone Local Registration
      const fallbackUser: UserProfile = {
        id: "usr_" + Math.random().toString(36).substring(2, 9),
        name,
        email,
        emailVerified: true,
        savedDestinationIds: ["sigiriya", "ella"],
        createdAt: new Date().toISOString(),
      };
      setUser(fallbackUser);
      localStorage.setItem("travellife_local_user", JSON.stringify(fallbackUser));
      setIsLoading(false);
      return { success: true };
    }
  };

  // User Login
  const loginUser = async (email: string, pass: string) => {
    setIsLoading(true);
    if (isSupabaseConfigured && supabase) {
      const { error } = await supabase.auth.signInWithPassword({ email, password: pass });
      setIsLoading(false);
      if (error) return { success: false, message: error.message };
      return { success: true };
    } else {
      // Standalone Local Login
      const fallbackUser: UserProfile = {
        id: "usr_local",
        name: email.split("@")[0],
        email,
        emailVerified: true,
        savedDestinationIds: ["sigiriya", "ella"],
        createdAt: new Date().toISOString(),
      };
      setUser(fallbackUser);
      localStorage.setItem("travellife_local_user", JSON.stringify(fallbackUser));
      setIsLoading(false);
      return { success: true };
    }
  };

  // Social OAuth Login
  const loginWithOAuth = async (provider: "google" | "facebook") => {
    if (isSupabaseConfigured && supabase) {
      await supabase.auth.signInWithOAuth({
        provider,
        options: { redirectTo: window.location.origin },
      });
    } else {
      alert(`OAuth (${provider}) requires VITE_SUPABASE_URL and OAuth credentials configured in Supabase.`);
    }
  };

  // Password Recovery
  const sendPasswordReset = async (email: string) => {
    if (isSupabaseConfigured && supabase) {
      const { error } = await supabase.auth.resetPasswordForEmail(email, {
        redirectTo: `${window.location.origin}/reset-password`,
      });
      if (error) return { success: false, message: error.message };
      return { success: true, message: "Password reset link sent to your email!" };
    }
    return { success: true, message: "Demo mode: Password reset instructions simulated." };
  };

  // Logout
  const logoutUser = async () => {
    if (isSupabaseConfigured && supabase) {
      await supabase.auth.signOut();
    }
    setUser(null);
    localStorage.removeItem("travellife_local_user");
  };

  // Destination Wishlist Sync
  const toggleSaveDestination = (destId: string) => {
    if (!user) return;
    const current = user.savedDestinationIds;
    const next = current.includes(destId)
      ? current.filter((id) => id !== destId)
      : [...current, destId];

    const updated = { ...user, savedDestinationIds: next };
    setUser(updated);
    localStorage.setItem(`wishlist_${user.id}`, JSON.stringify(next));
    if (!isSupabaseConfigured) {
      localStorage.setItem("travellife_local_user", JSON.stringify(updated));
    }
  };

  const isSaved = (destId: string) => {
    return Boolean(user?.savedDestinationIds?.includes(destId));
  };

  // Existing Admin Preservation Handlers
  const loginAdmin = (token: string, username: string) => {
    localStorage.setItem("travellife_admin_token", token);
    localStorage.setItem("travellife_admin_user", username);
    setAdmin({ isAdmin: true, username, token });
  };

  const logoutAdmin = () => {
    localStorage.removeItem("travellife_admin_token");
    localStorage.removeItem("travellife_admin_user");
    setAdmin(null);
  };

  return (
    <AuthContext.Provider
      value={{
        user,
        admin,
        isLoading,
        isSupabaseLive: isSupabaseConfigured,
        signUpUser,
        loginUser,
        loginWithOAuth,
        logoutUser,
        sendPasswordReset,
        toggleSaveDestination,
        isSaved,
        loginAdmin,
        logoutAdmin,
      }}
    >
      {children}
    </AuthContext.Provider>
  );
};

export const useAuth = () => {
  const context = useContext(AuthContext);
  if (!context) throw new Error("useAuth must be used within AuthProvider");
  return context;
};
