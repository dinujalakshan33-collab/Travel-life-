# Travel-Life Private Administrator Authentication Settings
# Set these securely in your Vercel Project Settings > Environment Variables

# The private email address authorized to access the private Administrator Portal
ADMIN_EMAIL="dinujalakshan33@gmail.com"

# The secure private password for administrator login
ADMIN_PASSWORD="YourSecurePasswordHere"

# Cryptographic secret key used to sign session JWT tokens (minimum 32 characters)
JWT_SECRET="travel-life-secure-jwt-secret-key-32chars-min-change-in-production"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
# Supabase Public Keys (Safe for frontend/Vercel)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Backend Admin & Express Server Secrets (Server-side only; never prefix with VITE_)
JWT_SECRET=your_super_secret_jwt_key
ADMIN_EMAIL=admin@travellife.com
PORT=5000
