// src/context/AuthContext.tsx
import React, { createContext, useContext, useState, useEffect } from "react";

export interface User {
  id: string;
  name: string;
  email: string;
  savedDestinationIds: string[];
}

interface AuthContextType {
  user: User | null;
  isAuthenticated: boolean;
  login: (email: string, name?: string) => Promise<boolean>;
  logout: () => void;
  toggleSaveDestination: (id: string) => void;
  isSaved: (id: string) => boolean;
}

const AuthContext = createContext<AuthContextType | undefined>(undefined);

export const AuthProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [user, setUser] = useState<User | null>(null);

  useEffect(() => {
    const saved = localStorage.getItem("travellife_user");
    if (saved) {
      try {
        setUser(JSON.parse(saved));
      } catch {
        localStorage.removeItem("travellife_user");
      }
    }
  }, []);

  const saveUserToState = (updated: User | null) => {
    setUser(updated);
    if (updated) {
      localStorage.setItem("travellife_user", JSON.stringify(updated));
    } else {
      localStorage.removeItem("travellife_user");
    }
  };

  const login = async (email: string, name?: string): Promise<boolean> => {
    // Authenticates user and preserves existing wishlist
    const existingSaved = user?.savedDestinationIds || ["sigiriya", "ella"];
    const newUser: User = {
      id: "usr_" + Math.random().toString(36).substring(2, 9),
      name: name || email.split("@")[0],
      email,
      savedDestinationIds: existingSaved,
    };
    saveUserToState(newUser);
    return true;
  };

  const logout = () => {
    saveUserToState(null);
  };

  const toggleSaveDestination = (id: string) => {
    if (!user) {
      // Allow guest wishlists saved to local profile
      const guestUser: User = {
        id: "guest",
        name: "Guest Explorer",
        email: "guest@travellife.com",
        savedDestinationIds: [id],
      };
      saveUserToState(guestUser);
      return;
    }

    const current = user.savedDestinationIds;
    const next = current.includes(id)
      ? current.filter((item) => item !== id)
      : [...current, id];

    saveUserToState({ ...user, savedDestinationIds: next });
  };

  const isSaved = (id: string) => {
    return !!user?.savedDestinationIds.includes(id);
  };

  return (
    <AuthContext.Provider
      value={{
        user,
        isAuthenticated: !!user && user.id !== "guest",
        login,
        logout,
        toggleSaveDestination,
        isSaved,
      }}
    >
      {children}
    </AuthContext.Provider>
  );
};

export const useAuth = () => {
  const context = useContext(AuthContext);
  if (!context) throw new Error("useAuth must be used within AuthProvider");
  return context;
};
